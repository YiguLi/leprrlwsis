# ===== 排除范围 =====
# 仅排除两类：训练产物目录 output/ 与压缩包。
# 其余所有文件（源码、数据、文档、编译缓存等）全部入库。

# 1) 训练产物：本地 7 GB+，每步 CSV 与 TensorBoard 日志，不入库
/output/

# 1b) Python 字节码缓存（曾一度入库，噪音大且随解释器版本变动；已从索引移除）
__pycache__/
*.pyc
*.pyo

# 2) 压缩包
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
# 例外：documentation/documentation.7z 由 documentation/.gitignore 中的
# !documentation.7z 规则显式保留在库中（该目录的规则优先于本文件）。

# 3) agentutil/ —— 脚本入库，运行产物不入库
#    （约定见 AGENTS.md：项目无关的临时/自建脚本一律放这里）
/agentutil/_scratch/
/agentutil/*.csv
/agentutil/*.png
/agentutil/*.log
/agentutil/*.tb
/agentutil/runs/
