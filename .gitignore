# ===== Generated output & large raw data (not code) =====
# Training output — hundreds of MB of per-run artifacts
/output/

# TensorBoard / experiment run artifacts (regenerable training logs)
/runs/

# A full duplicate copy of the project ("未命名" = "unnamed"); not tracked
/未命名/

# Raw wind measurement data (44 MB, 2007-2010)
/FFC_Mast_Wind_Data/

# Large generated wind-speed sequences
/FFC_speed_1.csv
/FFC_speed_noise_1.csv

# Whole-project archive (137 MB), not versioned
/HSRL.zip

# data_LES/ and documentation/ manage themselves via their own .gitignore

# ===== Secrets / API keys =====
# LLM provider config holds a plaintext api_key -> never commit.
# Local copies stay on disk; copy llm_config.example.json to create one,
# or leave api_key empty and export DEEPSEEK_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY.
llm_config.json

